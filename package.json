{
  "name": "catsker-jsontocsv",
  "version": "1.0.0",
  "description": "A robust, memory-efficient Node.js CLI utility designed for generating, converting, and uploading gigabyte-sized JSON files to Google Drive without loading entire datasets into memory.",
  "main": "src/main.js",
  "bin": {
    "catsker-jsontocsv": "src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "generate": "node src/main.js generate",
    "generate:small": "node src/main.js generate --size 0.01",
    "convert": "node src/main.js convert",
    "upload": "node src/main.js upload"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catsker/Json-to-csv.git"
  },
  "keywords": [],
  "author": "Pavel Kazarenka",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Catsker/Json-to-csv/issues"
  },
  "homepage": "https://github.com/Catsker/Json-to-csv#readme",
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "googleapis": "^178.0.0"
  },
  "files": [
    "src/",
    "assets/test.json"
  ]
}
